# ── Web App Settings ──────────────────────────────────────────────
# Google Sheets credentials (use ONE of these methods):
# Method 1: Path to credentials JSON file
GOOGLE_CREDS_FILE=credentials.json
# Method 2: Paste the entire JSON as a string (recommended for Render hosting)
# GOOGLE_CREDS_JSON={"type":"service_account","project_id":"..."}

# Name of your Google Sheet (must be shared with the service account email)
GOOGLE_SHEET_NAME=HealthScreening

# Port (set automatically by Render, use 5000 for local testing)
PORT=5000

# ── Local MRZ Watcher Settings (for mrz_watcher.py) ──────────────
MRZ_WATCH_FOLDER=C:\MRZ_Scans
APP_URL=https://your-app-name.onrender.com

# ── Local Signature Watcher Settings (for sig_watcher.py) ────────
SIG_WATCH_FOLDER=C:\Signatures
SIG_OUTPUT_FOLDER=C:\CompletedForms
MOM_FORM_TEMPLATE=C:\Templates\WPCM_form.pdf
PREGNANCY_DECL_TEMPLATE=C:\Templates\pregnancy_declaration.pdf
PATIENT_DATA_FILE=C:\clinic_data\current_patient.json
