# ── Registration Flask App ────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
REGISTRATION_PORT=5100

# ── MRZ Scanner Watcher ───────────────────────────────────────────────────────
# Folder where the MRZ scanner deposits .txt files
MRZ_WATCH_FOLDER=C:\MRZ_Scanner\Output
# URL of the registration app (change if running on a different machine)
REGISTRATION_URL=http://localhost:5100
# Delete the .txt file after processing (true/false)
MRZ_DELETE_AFTER=false

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to your Google service account JSON key file
GOOGLE_CREDENTIALS_JSON=credentials.json
# The spreadsheet ID from the Google Sheets URL
# e.g.  https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
#                                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
# Name of the tab/sheet to write to (will be created automatically if missing)
GOOGLE_SHEET_NAME=Registrations

# ── Label Printing ────────────────────────────────────────────────────────────
# Clinic name printed on each label
CLINIC_NAME=Health Screening Clinic
