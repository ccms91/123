# ══════════════════════════════════════════════════════════════════════
# Health Screening Clinic - Environment Variables
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env  (never commit .env to git)
# Fill in your own values below.
# ══════════════════════════════════════════════════════════════════════

# ── Google Sheets credentials  (choose ONE method) ────────────────────
# Method 1: Path to the JSON file you downloaded from Google Cloud
GOOGLE_CREDS_FILE=credentials.json

# Method 2: Paste the ENTIRE JSON as one line (required for Render hosting)
# GOOGLE_CREDS_JSON={"type":"service_account","project_id":"..."}

# Name of your Google Spreadsheet (must match exactly)
GOOGLE_SHEET_NAME=HealthScreening

# ── Web server port ────────────────────────────────────────────────────
# 5000 for local; Render sets this automatically.
PORT=5000

# ── App URL (used by local watcher scripts to open the browser) ────────
# Local:  http://localhost:5000
# Render: https://your-app-name.onrender.com
APP_URL=http://localhost:5000

# ══════════════════════════════════════════════════════════════════════
# LOCAL WATCHER SCRIPTS  (only needed for scripts in local/)
# These run on the clinic Windows PC, not on the server.
# ══════════════════════════════════════════════════════════════════════

# ── Station 1: MRZ passport scanner watcher ───────────────────────────
MRZ_WATCH_FOLDER=C:\MRZ_Scans

# ── Station 1: Signature pad watcher ──────────────────────────────────
SIG_WATCH_FOLDER=C:\Signatures
SIG_OUTPUT_FOLDER=C:\CompletedForms
MOM_FORM_TEMPLATE=C:\Templates\WPCM_form.pdf
PREGNANCY_DECL_TEMPLATE=C:\Templates\pregnancy_declaration.pdf
PATIENT_DATA_FILE=C:\clinic_data\current_patient.json

# ── Station 3(a): Urine dipstick camera watcher ───────────────────────
URINE_WATCH_FOLDER=C:\UrineCamImages
URINE_LOG_FOLDER=C:\UrineCamImages\debug

# Urine box camera calibration — pixel coordinates (run --calibrate to measure)
# REF_STRIP_X=60
# REF_STRIP_Y=200
# REF_STRIP_W=22
# REF_STRIP_H=220
# PAT_STRIP_X=120
# PAT_STRIP_Y=200
# PAT_STRIP_W=22
# PAT_STRIP_H=220
# PAT_STRIP_GAP=30
# PREG_STRIP_X=200
# PREG_STRIP_Y=200
# PREG_STRIP_W=16
# PREG_STRIP_H=130

# Colour comparison sensitivity  (lower = stricter positive threshold)
# NEGATIVE_DELTA_E=15
# POSITIVE_DELTA_E=30
